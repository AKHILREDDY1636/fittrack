{
  "name": "FitTrack",
  "short_name": "FitTrack",
  "description": "Daily fitness, meals and body composition tracker",
  "id": "./",
  "start_url": "./log.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#EAF0EE",
  "theme_color": "#1F7A63",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log today", "url": "./log.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Analytics", "url": "./analytics.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
